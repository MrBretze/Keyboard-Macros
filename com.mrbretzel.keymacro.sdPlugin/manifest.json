{
	"Name": "Keyboard Macros",
	"Description": "Record, edit (timing included) and replay keyboard macros.",
	"Author": "MrBretzel",
	"URL": "https://github.com/MrBretze/Keyboard-Macros",
	"Version": "2.2.0",
	"SDKVersion": 2,
	"Icon": "icons/plugin",
	"Category": "Keyboard Macros",
	"CategoryIcon": "icons/plugin",
	"CodePathLin": "keymacro-linux-x86_64",
	"CodePathWin": "keymacro-windows-x86_64.exe",
	"CodePathMac": "keymacro-macos",
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "keymacro-linux-x86_64",
		"aarch64-unknown-linux-gnu": "keymacro-linux-aarch64",
		"x86_64-pc-windows-msvc": "keymacro-windows-x86_64.exe",
		"x86_64-apple-darwin": "keymacro-macos",
		"aarch64-apple-darwin": "keymacro-macos"
	},
	"OS": [
		{
			"Platform": "linux"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		}
	],
	"Software": {
		"MinimumVersion": "6.0"
	},
	"Actions": [
		{
			"UUID": "com.mrbretzel.keymacro.macro",
			"Name": "Keyboard macro",
			"Icon": "icons/action",
			"Tooltip": "Replays a recorded keyboard macro (press again to stop it)",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"PropertyInspectorPath": "pi/index.html",
			"States": [
				{
					"Image": "icons/state_idle",
					"Name": "Ready"
				},
				{
					"Image": "icons/state_play",
					"Name": "Playing"
				},
				{
					"Image": "icons/state_rec",
					"Name": "Recording"
				}
			],
			"Encoder": {
				"layout": "$X1",
				"Icon": "icons/action",
				"TriggerDescription": {
					"Rotate": "Turn right / left: run the matching macro once per notch",
					"Push": "Play / stop the main macro",
					"Touch": "Play / stop the main macro"
				}
			}
		}
	]
}
